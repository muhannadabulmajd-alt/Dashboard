# --- Database (PostgreSQL) ---
# Local dev points at the in-container Postgres cluster. In production use a
# pooled Neon connection for app traffic and the matching non-pooled connection
# for migrations.
DATABASE_URL="postgresql://laheeb:laheeb@127.0.0.1:5432/laheeb?schema=public"
DIRECT_URL="postgresql://laheeb:laheeb@127.0.0.1:5432/laheeb?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate a strong secret with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Required when not running behind Vercel's trusted host.
AUTH_TRUST_HOST=true

# --- First-run admin bootstrap (no terminal needed) ---
# On a fresh deployment with an empty database, signing in with these exact
# credentials creates your OWNER account automatically. Ignored once any user
# exists. Use a strong password.
ADMIN_EMAIL="you@laheeb.coffee"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- App ---
# Optional configurable IQD->USD reporting rate (used only for the dual-currency
# display on the P&L page; never used to silently merge currencies).
NEXT_PUBLIC_USD_PER_IQD="0.00076"

# Secret guarding the scheduled-report and connector cron endpoints.
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me-to-a-long-random-cron-secret"

# --- Private Atlas AI Assistant (Owner/Admin only) ---
# Use separate OpenAI projects or keys for Preview and Production.
OPENAI_API_KEY=""
AI_ASSISTANT_ENABLED="false"
AI_ASSISTANT_MODEL="gpt-5.4-mini-2026-03-17"
AI_ASSISTANT_MAX_REQUESTS_PER_MINUTE="10"
AI_ASSISTANT_HISTORY_RETENTION_DAYS="90"

# --- Scheduled report email delivery (optional) ---
# When RESEND_API_KEY is set, scheduled reports are emailed via Resend; otherwise
# a no-op "log" provider is used so the pipeline still runs in development.
RESEND_API_KEY=""
REPORT_FROM="Laheeb Atlas <reports@laheeb.coffee>"
# Comma-separated; defaults to active owner/admin/finance users when empty.
REPORT_RECIPIENTS=""

# --- Connector credential encryption (AES-256-GCM) ---
# 32-byte key, base64 or hex. Used to encrypt connector secrets at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

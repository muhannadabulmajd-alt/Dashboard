# --- Database (PostgreSQL) ---
# Local dev points at the in-container Postgres cluster. In production use a
# pooled Neon/Supabase connection string.
DATABASE_URL="postgresql://laheeb:laheeb@127.0.0.1:5432/laheeb?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate a strong secret with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Required when not running behind Vercel's trusted host.
AUTH_TRUST_HOST=true

# --- App ---
# Optional configurable IQD->USD reporting rate (used only for the dual-currency
# display on the P&L page; never used to silently merge currencies).
NEXT_PUBLIC_USD_PER_IQD="0.00076"

# Secret guarding the scheduled-report cron endpoint (/api/reports/scheduled).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me-to-a-long-random-cron-secret"

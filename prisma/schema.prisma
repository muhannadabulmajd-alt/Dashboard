// Laheeb Operations Atlas — data model
// Money is stored as integer minor units (IQD = whole dinar, USD = cents) + a
// currency code. Weights are integer grams. Rates/scores are Float. Derived
// metrics (net sales, margins, yield, coverage days, …) are computed in
// src/lib/metrics, never persisted, so there is exactly one definition.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  ROASTERY_OPS
  FINANCE
  SALES_CRM
  BRANCH_MANAGER
  FRANCHISEE_VIEWER
  VIEWER
}

enum DashboardVisibility {
  PRIVATE
  SHARED
}

enum Channel {
  ONLINE_STORE
  POS
  CAFE
  WHOLESALE
  EVENTS
  SOCIAL
  RESELLERS
  CORPORATE
}

enum Governorate {
  BAGHDAD
  ERBIL
  BASRA
  NAJAF
  MOSUL
  SULAYMANIYAH
  KARBALA
  KIRKUK
  DUHOK
  WASIT
  DIYALA
  DHI_QAR
  ANBAR
  BABYLON
  MAYSAN
  MUTHANNA
  DIWANIYAH
  SALAHUDDIN
  HALABJA
  OTHER
}

enum ProductLine {
  TURKISH
  ESPRESSO
  FILTER
  DRIP_BAGS
  SINGLE_ORIGIN
  BLENDS
  ACCESSORIES
}

enum Grind {
  WHOLE_BEAN
  ESPRESSO
  FILTER
  TURKISH
  MOKA
  NONE
}

enum RoastLevel {
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  RETURNED
  REFUNDED
}

enum FulfillmentMethod {
  PICKUP
  COURIER
  INTERNAL_DELIVERY
  B2B
  BRANCH_SALE
}

enum CustomerSegment {
  NEW
  RETURNING
  LOYAL
  INACTIVE
  WHOLESALE
  CORPORATE
  FRANCHISE
}

enum MovementReason {
  OPENING
  PURCHASE
  PRODUCTION_OUT
  PRODUCTION_IN
  SOLD
  SAMPLED
  WASTED
  TEST
  GIVEAWAY
  INTERNAL
  ADJUSTMENT
}

enum InventorySyncMode {
  NORMAL
  SKIP_HISTORICAL
}

enum InventoryCategory {
  GREEN_COFFEE
  ROASTED
  DRIP_BAGS
  PACKAGING
  PRODUCTION_SUPPLY
  ACCESSORY
}

enum ExpenseCategoryType {
  GREEN_COFFEE
  PACKAGING
  SHIPPING
  SALARIES
  RENT
  MARKETING
  UTILITIES
  TECH
  MAINTENANCE
  EQUIPMENT
  OVERHEAD
}

enum ShipmentStatus {
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum Currency {
  IQD
  USD
}

enum DiscountType {
  PERCENT
  FIXED
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum DatasetType {
  PRODUCTS
  ORDERS
  CUSTOMERS
  BATCHES
  INVENTORY
  EXPENSES
  CAPITAL
  OFFERS
  SHIPMENTS
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  hashedPassword String
  role           Role      @default(VIEWER)
  isActive       Boolean   @default(true)
  branchId       String?
  createdById    String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch          Branch?          @relation(fields: [branchId], references: [id])
  createdBy       User?            @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers    User[]           @relation("UserCreatedBy")
  operatedBatches RoastBatch[]     @relation("BatchOperator")
  createdOrders   Order[]          @relation("OrderCreatedBy")
  dashboards      Dashboard[]      @relation("DashboardOwner")
  dashboardShares DashboardShare[]
  auditLogs       AuditLog[]
  providerSettlements ProviderSettlement[]

  @@index([role])
  @@index([branchId])
}

model Dashboard {
  id          String              @id @default(cuid())
  name        String
  description String?
  ownerId     String
  visibility  DashboardVisibility @default(PRIVATE)
  isDefault   Boolean             @default(false)
  isPinned    Boolean             @default(false)
  config      Json
  draftConfig Json?
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  owner  User             @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shares DashboardShare[]

  @@index([ownerId])
  @@index([visibility])
  @@index([deletedAt])
  @@index([isPinned])
}

model DashboardShare {
  id          String   @id @default(cuid())
  dashboardId String
  userId      String?
  role        Role?
  canEdit     Boolean  @default(false)
  canExport   Boolean  @default(true)
  createdAt   DateTime @default(now())

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@unique([dashboardId, role])
  @@index([userId])
  @@index([role])
}

model Branch {
  id          String  @id @default(cuid())
  code        String  @unique
  nameEn      String
  nameAr      String
  branchType  String  @default("COMPANY") // HQ | COMPANY | FRANCHISE (§12)
  governorate String  @default("BAGHDAD") // list-managed code
  isFranchise Boolean @default(false) // kept in sync with branchType for data scoping
  isActive    Boolean @default(true)

  // Location & contact
  city         String?
  address      String?
  street       String?
  notes        String?
  phone        String?
  email        String?
  managerName  String?
  managerPhone String?
  managerEmail String?

  // Franchise (when branchType = FRANCHISE)
  franchiseeName  String?
  franchiseePhone String?
  franchiseeEmail String?
  agreementStart  DateTime?
  agreementEnd    DateTime?

  // Operational
  openingDate    DateTime?
  operatingHours String?
  hasDelivery    Boolean   @default(false)
  hasPos         Boolean   @default(false)
  trackInventory Boolean   @default(true)
  hasWarehouse   Boolean   @default(false)

  createdAt DateTime @default(now())

  users          User[]
  orders         Order[]
  stockMovements StockMovement[]
  expenses       Expense[]
  batches        RoastBatch[]
  inventoryItems InventoryItem[]
  fixedAssets    FixedAsset[]
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id                 String      @id @default(cuid())
  sku                String      @unique
  barcodeValue       String      @unique
  nameEn             String
  nameAr             String
  productLine        ProductLine
  groupId            String? // CR/BRD: parent product group (variations module)
  sizeGrams          Int?
  sizeLabel          String
  grind              String      @default("NONE") // list-managed code
  roastLevel         String? // list-managed code
  origin             String?
  isBlend            Boolean     @default(false)
  variationType      String? // what makes this variation differ: size / grind / roast / packaging / flavor
  imageUrl           String?
  sellingPrice       Int // minor units of sellingCurrency (current base price)
  sellingCurrency    Currency    @default(IQD)
  sellUnit           String      @default("unit")
  minSellingPrice    Int? // optional floor for manual price overrides
  cogsPerUnit        Int // minor units of sellingCurrency
  invoiceName        String? // display name on the invoice (defaults to name)
  allowDiscount      Boolean     @default(true) // order usage (§6)
  allowPriceOverride Boolean     @default(true)
  trackInventory     Boolean     @default(true) // deduct finished stock on sale
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  orderLines     OrderLine[]
  batchLinks     BatchSkuLink[]
  inventoryItems InventoryItem[]
  components     ProductComponent[]
  prices         ProductPrice[]
  group          ProductGroup?      @relation(fields: [groupId], references: [id])

  @@index([productLine])
  @@index([grind])
  @@index([isActive])
  @@index([groupId])
}

/// Price entries for a variation (§6): base, wholesale or channel-specific,
/// each effective from a date. The latest non-future BASE entry is the current
/// selling price; future entries are scheduled. Immutable history.
model ProductPrice {
  id            String   @id @default(cuid())
  productId     String
  kind          String   @default("BASE") // BASE | WHOLESALE | CHANNEL
  channel       String? // set when kind = CHANNEL; list-managed code
  price         Int // minor units
  currency      Currency @default(IQD)
  effectiveFrom DateTime
  note          String?
  createdAt     DateTime @default(now())
  createdById   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind, effectiveFrom])
}

// Cost recipe (BOM) line for a variation (§16 component-based cost): the
// variation's cost = Σ(quantity × unitCost). Recomputing sets Product.cogsPerUnit
// (which is snapshotted onto orders, so history is preserved).
model ProductComponent {
  id              String   @id @default(cuid())
  productId       String
  inventoryItemId String? // linked stock item: cost is dynamic + drives capacity (§5-7)
  name            String // label, e.g. "Green beans", "Bag", "Label", "Cardamom", "Labor"
  quantity        Decimal  @default(1) @db.Decimal(14, 3)
  unitCost        Decimal  @db.Decimal(14, 3) // minor units IQD per unit (live item cost when linked, else manual)
  createdAt       DateTime @default(now())

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([inventoryItemId])
}

// Parent product (Products Variations Module): groups the sellable products
// (variations) such as "Espresso Spring" → its 200g/500g/1kg, ground/whole-bean
// SKUs. The variation = Product; the variation ID = the product's immutable SKU.
model ProductGroup {
  id          String      @id @default(cuid())
  code        String      @unique // auto-generated, immutable: PG-000001
  nameEn      String
  nameAr      String
  productLine ProductLine
  productType String? // free-text kind, e.g. "Coffee", "Gift", "Merch"
  description String?
  imageUrl    String? // optional image (URL)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products Product[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id             String          @id @default(cuid())
  externalId     String?         @unique
  phone          String?
  email          String?
  nameEn         String?
  nameAr         String?
  governorate    String? // list-managed code
  address1       String? // CR-6: street address line
  street         String? // CR-6: extra street / landmark details
  notes          String? // CR-6: free-form customer notes
  segment        CustomerSegment @default(NEW)
  campaignSource String? // CR-6: acquisition source (Instagram/Facebook/…)
  firstOrderAt   DateTime?
  lastOrderAt    DateTime?
  ordersCount    Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  orders Order[]

  @@index([segment])
  @@index([governorate])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  placedAt          DateTime
  customerId        String?
  branchId          String?
  createdById       String?
  channel           String // list-managed (§9): code from the "channel" system list
  governorate       String // list-managed code
  fulfillmentMethod FulfillmentMethod
  status            String            @default("COMPLETED") // list-managed code
  currency          Currency          @default(IQD)
  grossAmount       Int               @default(0)
  discountAmount    Int               @default(0) // total: line discounts + orderDiscount
  orderDiscount     Int               @default(0) // CR-2: order-level discount (part of discountAmount)
  extraCharges      Int               @default(0) // CR-2: extra charges added to the invoice total
  refundAmount      Int               @default(0)
  deliveryFee       Int               @default(0)
  deliveryCost      Int               @default(0)
  notes             String? // CR-2: free-form order notes
  offerId           String?
  uploadBatchId     String?
  inventorySyncMode InventorySyncMode @default(NORMAL)
  createdAt         DateTime          @default(now())

  lines          OrderLine[]
  customer       Customer?       @relation(fields: [customerId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  createdBy      User?           @relation("OrderCreatedBy", fields: [createdById], references: [id])
  offer          Offer?          @relation(fields: [offerId], references: [id])
  shipment       Shipment?
  stockMovements StockMovement[]

  @@index([placedAt])
  @@index([channel])
  @@index([governorate])
  @@index([status])
  @@index([customerId])
  @@index([offerId])
  @@index([createdById])
}

model OrderLine {
  id               String @id @default(cuid())
  orderId          String
  productId        String
  sku              String // denormalized snapshot
  quantity         Int
  unitLabel        String @default("unit")
  unitGrossPrice   Int
  lineDiscount     Int    @default(0)
  lineNet          Int
  unitCogsSnapshot Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Production
// ---------------------------------------------------------------------------

model RoastBatch {
  id                     String    @id @default(cuid())
  batchNumber            String    @unique
  roastDate              DateTime?
  packagingDate          DateTime?
  origin                 String
  roastLevel             String? // list-managed code
  profileNotes           String?
  greenInputGrams        Int
  roastedOutputGrams     Int?
  qcScore                Float?
  qcNotes                String?
  operatorId             String?
  branchId               String?
  uploadBatchId          String?
  greenInventoryItemId   String?
  roastedInventoryItemId String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())

  operator             User?                @relation("BatchOperator", fields: [operatorId], references: [id])
  branch               Branch?              @relation(fields: [branchId], references: [id])
  greenInventoryItem   InventoryItem?       @relation("BatchGreenInventory", fields: [greenInventoryItemId], references: [id])
  roastedInventoryItem InventoryItem?       @relation("BatchRoastedInventory", fields: [roastedInventoryItemId], references: [id])
  skuLinks             BatchSkuLink[]
  stockMovements       StockMovement[]
  costLayers           InventoryCostLayer[]

  @@index([roastDate])
  @@index([roastLevel])
  @@index([greenInventoryItemId])
  @@index([roastedInventoryItemId])
}

model BatchSkuLink {
  id             String @id @default(cuid())
  batchId        String
  productId      String
  allocatedGrams Int?

  batch   RoastBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@unique([batchId, productId])
}

// ---------------------------------------------------------------------------
// Inventory (ledger model: current stock = signed sum of movements)
// ---------------------------------------------------------------------------

model InventoryItem {
  id            String            @id @default(cuid())
  externalKey   String?           @unique
  category      InventoryCategory
  productId     String?
  nameEn        String
  nameAr        String
  unit          String // "g", "unit", "sachet"
  reorderPoint  Decimal?          @db.Decimal(14, 3)
  avgDailyUsage Float?
  unitCost      Decimal?          @db.Decimal(14, 3) // minor units IQD, for stock valuation
  branchId      String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  product        Product?             @relation(fields: [productId], references: [id])
  branch         Branch?              @relation(fields: [branchId], references: [id])
  movements      StockMovement[]
  recipeUses     ProductComponent[]
  costLayers     InventoryCostLayer[]
  ledgerLines    LedgerEntryLine[]
  greenBatches   RoastBatch[]         @relation("BatchGreenInventory")
  roastedBatches RoastBatch[]         @relation("BatchRoastedInventory")

  @@index([category])
}

// FIFO cost layer (§8): an immutable stock receipt at a unit cost. "Remaining"
// is derived by applying net stock-out oldest-first, so order edits/cancels
// adjust it automatically. The active (oldest non-empty) layer drives the
// item's current cost.
model InventoryCostLayer {
  id              String   @id @default(cuid())
  inventoryItemId String
  financeEntryId  String?
  roastBatchId    String?
  qtyReceived     Decimal  @db.Decimal(14, 3)
  unitCost        Decimal  @db.Decimal(14, 3) // minor units IQD per unit
  receivedAt      DateTime
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  financeEntry  FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  roastBatch    RoastBatch?   @relation(fields: [roastBatchId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, receivedAt])
  @@index([financeEntryId])
  @@index([roastBatchId])
}

model StockMovement {
  id              String         @id @default(cuid())
  inventoryItemId String
  financeEntryId  String?
  occurredAt      DateTime
  reason          MovementReason
  quantity        Decimal        @db.Decimal(14, 3) // signed: + in / - out, in the item's base unit
  reference       String?
  externalId      String?        @unique
  expiryDate      DateTime?
  branchId        String?
  uploadBatchId   String?
  orderId         String? // sales deduction source (variations module §18)
  roastBatchId    String?
  createdAt       DateTime       @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  financeEntry  FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  branch        Branch?       @relation(fields: [branchId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  roastBatch    RoastBatch?   @relation(fields: [roastBatchId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, occurredAt])
  @@index([financeEntryId])
  @@index([reason])
  @@index([orderId])
  @@index([roastBatchId])
}

model LedgerEntryLine {
  id              String               @id @default(cuid())
  financeEntryId  String
  lineNo          Int
  itemType        String               @default("EXPENSE") // INVENTORY | EXPENSE | SERVICE | OTHER
  itemName        String
  assetKey        String?
  assetCategory   String?
  categoryType    ExpenseCategoryType?
  inventoryItemId String?
  unit            String               @default("unit")
  quantity        Decimal              @db.Decimal(14, 3)
  unitCost        Decimal              @db.Decimal(14, 3) // entered base price in minor IQD per unit
  landedUnitCost  Decimal              @db.Decimal(14, 3) // final line total / quantity after discount and extras
  discountAmount  Int                  @default(0)
  extraAmount     Int                  @default(0)
  lineTotal       Int
  branchId        String?
  notes           String?
  createdAt       DateTime             @default(now())

  financeEntry  FinanceEntry   @relation(fields: [financeEntryId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@unique([financeEntryId, lineNo])
  @@index([financeEntryId])
  @@index([inventoryItemId])
  @@index([categoryType])
  @@index([itemType])
  @@index([assetKey])
}

model FixedAsset {
  id             String    @id @default(cuid())
  importKey      String?   @unique
  name           String
  category       String
  quantity       Decimal   @default(1) @db.Decimal(14, 3)
  unit           String
  totalCost      Int
  unitCost       Decimal   @db.Decimal(14, 3)
  purchaseDate   DateTime
  partyId        String?
  branchId       String?
  financeEntryId String?
  notes          String?
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  party        Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  financeEntry FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([partyId])
  @@index([branchId])
  @@index([isActive])
  @@index([financeEntryId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id     String              @id @default(cuid())
  type   ExpenseCategoryType @unique
  nameEn String
  nameAr String

  expenses Expense[]
}

model Expense {
  id            String   @id @default(cuid())
  categoryId    String
  incurredAt    DateTime
  amount        Int
  currency      Currency @default(IQD)
  vendor        String?
  note          String?
  branchId      String?
  uploadBatchId String?
  createdAt     DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  branch   Branch?         @relation(fields: [branchId], references: [id])

  @@index([incurredAt])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Offers
// ---------------------------------------------------------------------------

model Offer {
  id            String       @id @default(cuid())
  name          String
  code          String?      @unique
  isAutomatic   Boolean      @default(false)
  discountType  DiscountType @default(PERCENT)
  discountValue Float
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime     @default(now())

  orders Order[]
}

/// Editable overlay for system lists (§9–11). Merges OVER the static code lists:
/// a row overrides a built-in value's label/order/active state, or adds a new
/// value. `isSystem` rows have a locked code (rename label / reorder / hide,
/// but never delete or recode) so metric logic keyed on codes stays intact.
model ListOption {
  id         String   @id @default(cuid())
  listKey    String // 'channel','governorate','grind','roastLevel','orderStatus','fulfillment','customerSource', etc.
  code       String // stored value / stable identifier
  labelEn    String
  labelAr    String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  isSystem   Boolean  @default(false)
  metricRole String? // orderStatus only: OPEN | SALE | RETURN | CANCELED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([listKey, code])
  @@index([listKey, isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Fulfillment
// ---------------------------------------------------------------------------

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  courier        String
  status         ShipmentStatus @default(DISPATCHED)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  shippingCost   Int            @default(0)
  governorate    String // list-managed code
  failureReason  String?
  courierPartyId String?
  createdAt      DateTime       @default(now())

  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierParty Party? @relation(fields: [courierPartyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([courier])
  @@index([courierPartyId])
}

// ---------------------------------------------------------------------------
// Ingestion / audit (UploadBatch wired when CSV import lands; AuditLog used now)
// ---------------------------------------------------------------------------

model UploadBatch {
  id           String       @id @default(cuid())
  dataset      DatasetType
  fileName     String
  uploadedById String?
  uploadedAt   DateTime     @default(now())
  status       UploadStatus @default(PENDING)
  rowsTotal    Int          @default(0)
  rowsInserted Int          @default(0)
  rowsUpdated  Int          @default(0)
  rowsSkipped  Int          @default(0)
  errorReport  Json?

  @@index([dataset])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// System connectors (pull external data through the same ingestion path)
// ---------------------------------------------------------------------------

enum ConnectorType {
  SAMPLE
  HTTP_CSV
  SHOPIFY
  ODOO
  POS
  COURIER
}

enum ConnectorStatus {
  ACTIVE
  PAUSED
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model Connector {
  id         String          @id @default(cuid())
  name       String
  type       ConnectorType
  dataset    DatasetType
  status     ConnectorStatus @default(ACTIVE)
  config     Json?
  lastSyncAt DateTime?
  createdAt  DateTime        @default(now())

  runs SyncRun[]

  @@index([status])
}

model SyncRun {
  id           String     @id @default(cuid())
  connectorId  String
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  status       SyncStatus @default(SUCCESS)
  rowsInserted Int        @default(0)
  rowsUpdated  Int        @default(0)
  rowsSkipped  Int        @default(0)
  message      String?

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, startedAt])
}

// ---------------------------------------------------------------------------
// Finance / accounting (cashbook + AR/AP + capital)
// ---------------------------------------------------------------------------

enum AccountType {
  CASH
  BANK
  DIGITAL_WALLET
  PAYMENT_GATEWAY
  OTHER
}

enum PartyType {
  SUPPLIER
  RETAILER
  DISTRIBUTOR
  PARTNER
  CUSTOMER
  SHAREHOLDER
  EMPLOYEE
  SERVICE_PROVIDER
  OTHER
}

enum FinanceType {
  EXPENSE
  PURCHASE
  INCOME
  PAYMENT_IN
  PAYMENT_OUT
  CAPITAL_IN
  DRAWING
  TRANSFER
}

enum LedgerRecordClass {
  PURCHASE
  EXPENSE
  MIXED
}

enum ObligationKind {
  PAYABLE
  RECEIVABLE
}

model FinanceAccount {
  id             String      @id @default(cuid())
  externalKey    String?     @unique
  name           String
  type           AccountType
  bankName       String?
  branchId       String? // for CASH accounts: which branch holds the cash
  currency       Currency    @default(IQD)
  openingBalance Int         @default(0) // minor units
  notes          String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  entries   FinanceEntry[] @relation("AccountEntries")
  transfers FinanceEntry[] @relation("TransferTo")
  providerSettlements ProviderSettlement[]
  settlementParties Party[] @relation("PartyDefaultSettlementAccount")

  @@index([type])
}

model Party {
  id                String    @id @default(cuid())
  externalKey       String?   @unique
  name              String
  type              PartyType @default(OTHER)
  phone             String?
  email             String?
  address           String?
  branchId          String?
  openingPayable    Int       @default(0)
  openingReceivable Int       @default(0)
  notes             String?
  equityShare       Float? // ownership % (shareholders)
  defaultSettlementAccountId String?
  netFeesFromRemittance Boolean @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  entries     FinanceEntry[]
  fixedAssets FixedAsset[]
  shipments   Shipment[]
  defaultSettlementAccount FinanceAccount? @relation("PartyDefaultSettlementAccount", fields: [defaultSettlementAccountId], references: [id], onDelete: SetNull)
  providerSettlements ProviderSettlement[]

  @@index([type])
  @@index([branchId])
  @@index([defaultSettlementAccountId])
}

model ProviderSettlement {
  id             String   @id @default(cuid())
  providerPartyId String
  accountId      String
  date           DateTime
  grossCleared   Int
  feesOffset     Int      @default(0)
  amountReceived Int
  paymentMethod  String?
  reference      String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())

  provider Party @relation(fields: [providerPartyId], references: [id])
  account FinanceAccount @relation(fields: [accountId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id])
  entries FinanceEntry[]

  @@index([providerPartyId, date])
  @@index([accountId])
  @@index([createdById])
}

model FinanceEntry {
  id             String               @id @default(cuid())
  recordKey      String?              @unique // immutable Atlas spending key, e.g. DOC000169
  date           DateTime
  type           FinanceType
  recordClass    LedgerRecordClass?
  amount         Int // minor units, positive — ALWAYS the IQD value
  currency       Currency             @default(IQD)
  // Original payment when made in a foreign currency (e.g. paid in USD).
  // `amount`/`currency` stay IQD; these preserve "I paid origAmount origCurrency
  // at fxRate IQD per 1 unit" for the audit trail. Null for native-IQD entries.
  origCurrency   Currency?
  origAmount     Int? // minor units in origCurrency (USD cents)
  fxRate         Int? // IQD per 1 unit of origCurrency on the entry date
  // When obligation=true this is a payable/receivable that has NOT moved cash.
  // When false it is an actual cash movement on `account` (and `toAccount` for transfers).
  obligation     Boolean              @default(false)
  obligationKind ObligationKind?
  dueDate        DateTime?
  accountId      String?
  toAccountId    String?
  partyId        String?
  categoryType   ExpenseCategoryType?
  paymentMethod  String?
  settlesId      String? // payment that settles an obligation (partial allowed)
  importKey      String?              @unique // idempotent bulk import (re-uploads upsert)
  description    String?
  reference      String?
  attachmentUrl  String?
  branchId       String?
  orderId        String?
  createdById    String?
  providerSettlementId String?
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  reversalOfId   String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime             @default(now())

  account        FinanceAccount?      @relation("AccountEntries", fields: [accountId], references: [id])
  toAccount      FinanceAccount?      @relation("TransferTo", fields: [toAccountId], references: [id])
  party          Party?               @relation(fields: [partyId], references: [id])
  settles        FinanceEntry?        @relation("Settlements", fields: [settlesId], references: [id])
  settlements    FinanceEntry[]       @relation("Settlements")
  stockMovements StockMovement[]
  costLayers     InventoryCostLayer[]
  ledgerLines    LedgerEntryLine[]
  fixedAssets    FixedAsset[]
  providerSettlement ProviderSettlement? @relation(fields: [providerSettlementId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([type])
  @@index([recordClass])
  @@index([obligation])
  @@index([accountId])
  @@index([partyId])
  @@index([paymentMethod])
  @@index([settlesId])
  @@index([branchId])
  @@index([orderId])
  @@index([createdById])
  @@index([providerSettlementId])
  @@index([archivedAt])
  @@index([reversalOfId])
}

// Key/value app settings (e.g. usd_to_iqd conversion rate).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
